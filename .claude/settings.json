{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "fallbackModel": ["opus", "haiku"],
  "language": "romanian",
  "includeGitInstructions": true,
  "autoMemoryEnabled": true,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "inherit"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(rg *)",
      "Bash(yarn build)",
      "Bash(yarn test *)",
      "Bash(.\\.venv\\Scripts\\python.exe backend_test.py)",
      "Bash(.\\.venv\\Scripts\\python.exe -m compileall *)",
      "Bash(pytest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*.env)",
      "Read(./memory/test_credentials.md)",
      "Read(./.ifrim/private/**)",
      "Read(./.ifrim/tmp/**)",
      "Read(./backend/uploads/**)",
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(gh repo create *)",
      "Bash(gh auth *)"
    ]
  }
}
