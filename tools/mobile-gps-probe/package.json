{
  "name": "prodelivery-local-gps-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "expo": "57.0.26",
    "expo-crypto": "57.0.3",
    "expo-location": "57.0.20",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-task-manager": "57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "@expo/vector-icons": "15.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-location",
          "expo-task-manager",
          "unimodules-app-loader"
        ]
      }
    }
  }
}
